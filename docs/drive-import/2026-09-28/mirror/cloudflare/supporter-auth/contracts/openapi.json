  "components": {
    "securitySchemes": {
      "opaqueBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Club-scoped opaque access token; not a JWT."
      }
    },
    "schemas": {
      "ChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone",
          "clientSecret"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$"
          },
          "clientSecret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challengeId",
          "code",
          "clientSecret"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "clientSecret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 80,
            "maxLength": 80
          }
        }
      },
      "RevokeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "enum": [
              "current",
              "others",
              "all"
            ]
          }
        }
      },
      "DeletionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirmation"
        ],
        "properties": {
          "confirmation": {
            "const": "DELETE MY ACCOUNT"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "challengeId",
          "clubId",
          "expiresAt",
          "delivery"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "integer",
            "minimum": 1
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1
          },
          "delivery": {
            "const": "queued_or_pending"
          }
        }
      },
      "SessionBundle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "userId",
          "clubId",
          "sessionId",
          "accessToken",
          "refreshToken",
          "accessExpiresAt",
          "refreshExpiresAt",
          "authenticatedAt"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "integer",
            "minimum": 1
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string",
            "minLength": 80,
            "maxLength": 80
          },
          "refreshToken": {
            "type": "string",
            "minLength": 80,
            "maxLength": 80
          },
          "accessExpiresAt": {
            "type": "integer",
            "minimum": 1
          },
          "refreshExpiresAt": {
            "type": "integer",
            "minimum": 1
          },
          "authenticatedAt": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "userId",
          "clubId",
          "sessionId",
          "phoneVerified",
          "role",
          "authenticatedAt"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "integer",
            "minimum": 1
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "phoneVerified": {
            "const": true
          },
          "role": {
            "const": "supporter"
          },
          "authenticatedAt": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Revoked": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "scope",
          "revoked"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "scope": {
            "enum": [
              "current",
              "others",
              "all"
            ]
          },
          "revoked": {
            "const": true
          }
        }
      },
      "DeletionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "requestId",
          "state",
          "sessionsRevoked",
          "erasureCompleted"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "const": "pending_external_erasure"
          },
          "sessionsRevoked": {
            "const": true
          },
          "erasureCompleted": {
            "const": false
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "error"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "error": {
            "type": "string",
            "pattern": "^[a-z_]{1,80}$"
          }
        }
      }
    }
  }
}
