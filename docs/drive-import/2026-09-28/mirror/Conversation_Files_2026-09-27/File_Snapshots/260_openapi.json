  "components": {
    "securitySchemes": {
      "CloudflareAccess": {
        "type": "apiKey",
        "in": "cookie",
        "name": "CF_Authorization",
        "description": "Validated upstream by Cloudflare Access and consumed through runtime ctx.access only. This declaration does not authorize arbitrary cookies."
      }
    },
    "schemas": {
      "ReviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedPreviousId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{3,160}$"
          }
        },
        "required": [
          "snapshotId",
          "expectedPreviousId",
          "reviewRef"
        ]
      },
      "PublishRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "reviewId"
        ]
      },
      "Head": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clubId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999999999
          },
          "snapshotId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "capturedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "activatedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "fresh": {
            "type": "boolean"
          }
        },
        "required": [
          "clubId",
          "snapshotId",
          "capturedAt",
          "activatedAt",
          "fresh"
        ]
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewId": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999999999
          },
          "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedPreviousId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewRef": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0
          },
          "mediaCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "reviewId",
          "clubId",
          "snapshotId",
          "expectedPreviousId",
          "reviewRef",
          "expiresAt",
          "rowCount",
          "mediaCount"
        ]
      },
      "Publication": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999999999
          },
          "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "previousSnapshotId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "const": "published"
          },
          "replayed": {
            "type": "boolean"
          },
          "reviewId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "operationId",
          "clubId",
          "snapshotId",
          "previousSnapshotId",
          "publishedAt",
          "status",
          "replayed",
          "reviewId"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "requestId"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "error"
        ]
      },
      "HeadResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Head"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "data"
        ]
      },
      "ReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Review"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "data"
        ]
      },
      "PublicationResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/Publication"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "data"
        ]
      }
    }
  }
}
