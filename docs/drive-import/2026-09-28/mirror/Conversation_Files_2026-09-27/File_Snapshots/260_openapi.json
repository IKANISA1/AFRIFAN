            "name": "X-AFRICLUB-Action",
            "in": "header",
            "required": true,
            "schema": {
              "const": "publish-review"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "description": "Persist before sending. Retry the same review with the SAME key after uncertain response; do not automatically start a new operation."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
