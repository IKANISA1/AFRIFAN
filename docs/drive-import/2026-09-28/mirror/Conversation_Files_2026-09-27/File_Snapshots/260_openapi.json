{
  "openapi": "3.1.0",
  "info": {
    "title": "AFRICLUB operator public-source publication API",
    "version": "1.0.0",
    "description": "Staging source candidate. Only configured Rayon tenant is available. Runtime ctx.access authenticates human operators; the private service enforces live grants. Access cookies are handled by the browser. Raw identity headers and request-body approvers are never authority. No supporter authentication or financial commands."
  },
  "security": [
    {
      "CloudflareAccess": []
    }
  ],
