    "/v1/admin/clubs/{clubId}/public-source/publications": {
      "post": {
        "operationId": "confirmPublication",
        "parameters": [
          {
            "name": "clubId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999999999
