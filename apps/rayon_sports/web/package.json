{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "build": "node scripts/run-next-build-stable.mjs && node scripts/ensure-next-build-artifacts.mjs && node scripts/fix-route-group-manifests.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "lint:release-critical": "npm run lint",
    "playwright:cleanup": "node scripts/kill-playwright-ports.mjs",
    "test": "vitest run --coverage",
    "test:venue-coverage": "vitest run src/lib/data/venue-access.test.ts src/lib/data/venue-operations.test.ts --coverage --coverage.include=src/lib/data/venue-access.ts --coverage.include=src/lib/data/venue-operations.ts --coverage.thresholds.lines=100 --coverage.thresholds.statements=100 --coverage.thresholds.functions=100 --coverage.thresholds.branches=70",
    "test:e2e": "npm run playwright:cleanup && AFRICLUB_ALLOW_HTTP_PREVIEW=1 npm run build && node scripts/run-playwright-suite.mjs",
    "test:e2e:ci": "npm run playwright:cleanup && node scripts/run-playwright-suite.mjs",
    "test:e2e:wallet": "npm run playwright:cleanup && AFRICLUB_ALLOW_HTTP_PREVIEW=1 npm run build && node scripts/run-playwright-suite.mjs e2e/wallet.spec.ts --project=mobile-chromium --project=tablet-chromium",
    "test:lighthouse": "lhci autorun --config=.lighthouserc.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "size": "node scripts/check-app-shell-size.mjs",
    "qa:runtime-fallbacks": "node ../../../tools/scripts/scan_runtime_fallbacks.mjs",
    "qa:admin-performance": "node --experimental-strip-types scripts/benchmark-admin-collection.mjs",
    "qa:supabase:verify": "node scripts/verify-supabase-feature-stack.mjs",
    "qa:admin:live": "node scripts/run-admin-live-uat.mjs --report tmp/admin-live-uat-latest.json",
    "qa:wallet:seed": "node scripts/seed_wallet_qa_uat.mjs",
    "preview": "node scripts/sync-cloudflare-dev-vars.mjs && npm run build && opennextjs-cloudflare build --skipNextBuild && node scripts/fix-route-group-manifests.mjs --open-next && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare build --skipNextBuild && node scripts/fix-route-group-manifests.mjs --open-next && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "basic-ftp": "^5.3.1",
    "form-data": "^4.0.6",
    "ip-address": "^10.1.1",
    "js-yaml": "^4.2.0",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.6"
    },
    "postcss": "^8.5.10",
    "qs": "^6.15.3",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "vite": "^8.1.0",
    "ws": "^8.21.0",
    "lighthouse": {
      "ws": "^7.5.11"
    }
  }
}
