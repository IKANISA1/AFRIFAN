{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('tmp/deploy-check', { recursive: true, force: true }); fs.rmSync('.next/lock', { force: true });\" && node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build --webpack && node scripts/ensure-next-build-artifacts.mjs && node scripts/fix-route-group-manifests.mjs",
    "design-system:check": "node scripts/generate-design-tokens.mjs --check",
    "design-system:sync": "node scripts/generate-design-tokens.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "playwright:cleanup": "node scripts/kill-playwright-ports.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "npm run playwright:cleanup && npm run build && node scripts/run-playwright-suite.mjs",
    "test:e2e:ci": "npm run playwright:cleanup && node scripts/run-playwright-suite.mjs",
    "test:e2e:wallet": "npm run playwright:cleanup && npm run build && node scripts/run-playwright-suite.mjs e2e/wallet.spec.ts --project=mobile-chromium --project=tablet-chromium",
    "test:lighthouse": "lhci autorun --config=.lighthouserc.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "size": "node scripts/check-app-shell-size.mjs",
    "qa:wallet:seed": "node scripts/seed_wallet_qa_uat.mjs",
    "preview": "node scripts/sync-cloudflare-dev-vars.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "jsdom": "^29.0.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "basic-ftp": "^5.2.2",
    "tmp": "^0.2.5",
    "vite": "^8.0.8"
  }
}
