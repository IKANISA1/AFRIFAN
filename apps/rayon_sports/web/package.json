{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260801.1": true
  },
  "scripts": {
    "build": "node scripts/run-next-build-stable.mjs && node scripts/ensure-next-build-artifacts.mjs && node scripts/fix-route-group-manifests.mjs && node scripts/web-build-provenance.mjs seal",
    "check:dependencies": "node scripts/validate-package-manager.mjs && node --test scripts/dependency-security.node-test.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "lint:release-critical": "corepack npm run lint",
    "playwright:cleanup": "node scripts/kill-playwright-ports.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "corepack npm run playwright:cleanup && AFRICLUB_ALLOW_HTTP_PREVIEW=1 corepack npm run build && AFRICLUB_ALLOW_HTTP_PREVIEW=1 AFRICLUB_CONTROLLED_ADMIN_EVIDENCE=1 AFRICLUB_CONTROLLED_ROUTE_EVIDENCE=1 node scripts/run-playwright-suite.mjs",
    "test:e2e:ci": "corepack npm run playwright:cleanup && AFRICLUB_ALLOW_HTTP_PREVIEW=1 AFRICLUB_CONTROLLED_ADMIN_EVIDENCE=1 AFRICLUB_CONTROLLED_ROUTE_EVIDENCE=1 node scripts/run-playwright-suite.mjs",
    "test:e2e:wallet": "corepack npm run playwright:cleanup && AFRICLUB_ALLOW_HTTP_PREVIEW=1 corepack npm run build && node scripts/run-playwright-suite.mjs e2e/wallet.spec.ts --project=mobile-chromium --project=tablet-chromium",
    "test:lighthouse": "node scripts/run-lighthouse-audit.mjs",
    "test:cloudflare-release": "node --test scripts/validate-cloudflare-release.node-test.mjs",
    "test:evidence-provenance": "node --experimental-strip-types --test scripts/state-evidence-provenance.node-test.mjs",
    "test:build-provenance": "node --test scripts/web-build-provenance.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "size": "node scripts/check-app-shell-size.mjs",
    "qa:runtime-fallbacks": "node ../../../tools/scripts/scan_runtime_fallbacks.mjs",
    "qa:admin-performance": "node --expose-gc --experimental-strip-types scripts/benchmark-admin-collection.mjs",
    "qa:supabase:verify": "node scripts/verify-supabase-feature-stack.mjs",
    "qa:admin:live": "node scripts/run-admin-live-uat.mjs --report tmp/admin-live-uat-latest.json",
    "qa:wallet:seed": "node scripts/seed_wallet_qa_uat.mjs",
    "preview": "node scripts/sync-cloudflare-dev-vars.mjs && corepack npm run build && opennextjs-cloudflare build --skipNextBuild && node scripts/fix-route-group-manifests.mjs --open-next && opennextjs-cloudflare preview",
    "deploy": "corepack npm run build && opennextjs-cloudflare build --skipNextBuild && node scripts/fix-route-group-manifests.mjs --open-next && opennextjs-cloudflare deploy",
    "upload": "corepack npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "validate:cloudflare-release": "node scripts/validate-cloudflare-release.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "basic-ftp": "^5.3.1",
    "form-data": "^4.0.6",
    "ip-address": "^10.1.1",
    "js-yaml": "^4.3.2",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.6"
    },
    "postcss": "^8.5.10",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "vite": "^8.1.0",
    "ws": "^8.21.0"
  }
}
