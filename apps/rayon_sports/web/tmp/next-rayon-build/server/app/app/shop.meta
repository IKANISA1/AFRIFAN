{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/shop/layout,_N_T_/app/shop/page,_N_T_/app/shop"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/shop/__PAGE__",
    "/app/shop",
    "/app",
    "/_index",
    "/_head"
  ]
}