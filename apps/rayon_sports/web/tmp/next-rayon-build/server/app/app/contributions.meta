{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app/layout,_N_T_/app/contributions/layout,_N_T_/app/contributions/page,_N_T_/app/contributions"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app/contributions/__PAGE__",
    "/app/contributions",
    "/app",
    "/_index",
    "/_head"
  ]
}