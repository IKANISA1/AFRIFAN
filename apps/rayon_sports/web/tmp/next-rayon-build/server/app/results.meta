{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(site)/layout,_N_T_/(site)/results/layout,_N_T_/(site)/results/page,_N_T_/results"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHNpdGUp/results/__PAGE__",
    "/!KHNpdGUp/results",
    "/!KHNpdGUp",
    "/_index",
    "/_head"
  ]
}