{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(site)/layout,_N_T_/(site)/history/layout,_N_T_/(site)/history/page,_N_T_/history"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHNpdGUp/history/__PAGE__",
    "/!KHNpdGUp/history",
    "/!KHNpdGUp",
    "/_index",
    "/_head"
  ]
}