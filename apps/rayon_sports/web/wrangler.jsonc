{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "gikundiro-web",
	"workers_dev": true,
	"preview_urls": true,
	"compatibility_date": "2026-08-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": false,
		"logs": {
			"enabled": false,
			"invocation_logs": false,
			"head_sampling_rate": 0
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 0
		}
	},
	"routes": [
		{
			"pattern": "gikundiro.com",
			"zone_id": "6ea1b5005cb4305055062be88a5d65a8",
			"custom_domain": true
		},
		{
			"pattern": "www.gikundiro.com",
			"zone_id": "6ea1b5005cb4305055062be88a5d65a8",
			"custom_domain": true
		},
		{
			"pattern": "admin.gikundiro.com",
			"zone_id": "6ea1b5005cb4305055062be88a5d65a8",
			"custom_domain": true
		},
		{
			"pattern": "fans.gikundiro.com",
			"zone_id": "6ea1b5005cb4305055062be88a5d65a8",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gikundiro-web"
		}
	],
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "9bbaad3f566a4341ab5bffe439ce2c1f"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
