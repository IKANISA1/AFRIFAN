    {"order": 3, "journey": "Membership or supporter profile", "alt_text_draft": "Supporter membership status and profile controls"},
    {"order": 4, "journey": "Tickets or merchandise without real payment", "alt_text_draft": "Ticket or merchandise options with confirmation status"}
