  "WEB_OBSERVATIONS_POLICY_REF":""
 },
 "d1_databases":[{"binding":"WEB_OBSERVATIONS_DB","database_name":"NEW_REVIEWED_PRIVATE_WEB_OBSERVATIONS_DB",
