{
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "name": "africlub-allocation-delivery-inbox-staging",
  "main": "src/inbox-worker.mjs",
  "vars": {
    "INBOX_ENABLED": "false",
    "DELIVERY_ENVIRONMENT": "isolated-staging",
    "DELIVERY_CONSUMER_ID": "REVIEW_REQUIRED"
  },
  "d1_databases": [
    {
      "binding": "INBOX_DB",
      "database_name": "NEW_ISOLATED_OPERATIONS_INBOX",
      "database_id": "REVIEW_REQUIRED",
      "migrations_dir": "migrations"
    }
  ]
}
