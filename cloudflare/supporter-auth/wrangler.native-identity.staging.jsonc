{
  "name": "africlub-supporter-identity-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": false},
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "africlub-supporter-identity-staging",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "AUTH_SERVICE_ENABLED": "false",
    "AUTH_DELIVERY_ENABLED": "false",
    "AUTH_KEY_VERSION": "1",
    "AUTH_ORIGIN": "",
    "AUTH_ISSUANCE_POLICY_JSON": "",
    "AUTH_DELIVERY_MODE": "private-deduplicated",
    "AUTH_DELIVERY_POLICY_JSON": ""
  },
  "services": [{
    "binding": "OTP_DELIVERY",
    "service": "africlub-auth-code-delivery-staging",
    "entrypoint": "AuthenticationCodeDelivery"
  }],
  "ratelimits": [{
    "name": "AUTH_EDGE_LIMIT",
    "namespace_id": "0",
    "simple": {"limit": 100, "period": 60}
  }]
}
