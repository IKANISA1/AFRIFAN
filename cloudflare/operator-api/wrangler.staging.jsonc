{
  "name": "africlub-operator-publication-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "OPERATOR_API_ENABLED": "false",
    "OPERATOR_API_ORIGIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ACCOUNT_ID": "",
    "OPERATOR_UI_ENABLED": "false",
    "OPERATOR_CASES_ENABLED": "false",
    "OPERATOR_METRICS_ENABLED": "false"
  },
  "services": [
    {
      "binding": "PUBLIC_SOURCE_PUBLISHER",
      "service": "africlub-rayon-authorized-publisher-staging",
      "entrypoint": "AuthorizedPublicSourcePublisher"
    },
    {
      "binding": "PAYMENT_EXCEPTION_CASES",
      "service": "africlub-payment-exceptions-staging",
      "entrypoint": "PaymentExceptionCases"
    }
  ]
}
