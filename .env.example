# ─────────────────────────────────────────────────────────
# AFRICLUB Monorepo — Environment Variables (.env.example)
# ─────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in your values.
# NEVER commit your actual .env file to version control.
#
# App-specific Supabase credentials are injected via
# `assets/flavors/production.local.json` (gitignored).
# See `melos.yaml` > `build_club` for how flavors are loaded.
# ─────────────────────────────────────────────────────────

# ── Core (required for local dev & scripts) ──────────────
CLUB_ID=24
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Service role key — NEVER expose in client code or commit
# Only used by edge functions and admin scripts
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Firebase (Crashlytics + push notifications) ─────────
# google-services.json is committed (public Firebase config).
# The Firebase project must match the app's package name.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ── WhatsApp Cloud API (edge function: send-sms) ────────
# Used by the send-sms edge function to deliver OTP via WhatsApp.
# WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
# Supabase Auth HTTP Hook Standard Webhooks secret.
# Required format: v1,whsec_<standard-base64-secret>
# AUTH_HOOK_SEND_SMS_SECRET=v1,whsec_base64-secret

# ── API-Football (football-sync edge function) ──────────
# Used by the football-sync edge function to fetch live data.
# Set as a Supabase secret: supabase secrets set API_FOOTBALL_KEY=...
# API_FOOTBALL_KEY=your-api-football-key

# ── CI/CD (GitHub Actions only — NOT set here) ──────────
# These are set as repository secrets/vars, not in .env:
#
# ANDROID_KEYSTORE_BASE64       — Base64-encoded upload keystore
# ANDROID_KEYSTORE_PASSWORD     — Keystore password
# ANDROID_KEY_ALIAS             — Key alias
# ANDROID_KEY_PASSWORD          — Key password
# FIREBASE_SERVICE_ACCOUNT_JSON — Firebase SA for distribution
# NEXT_PUBLIC_SUPABASE_URL      — Production Supabase URL (GitHub var)
# NEXT_PUBLIC_SUPABASE_ANON_KEY — Production anon key (GitHub secret)

# Supabase Edge browser origin admission. Comma-separated exact approved origins.
# Unconfigured browser Origins fail closed; native/server callers omit Origin.
EDGE_ALLOWED_ORIGINS=
